@model IReadOnlyList<SolarMetrics.Web.Models.PainelSolar>
@{
    ViewData["Title"] = "Painéis solares";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="text-muted mb-0">Painéis por sistema</p>
    <a asp-action="Create" class="btn btn-primary btn-sm"><i class="fas fa-plus me-1"></i>Novo painel</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
            <tr>
                <th>Modelo</th>
                <th>Fabricante</th>
                <th>Sistema</th>
                <th>Potência máx. (W)</th>
                <th>Eficiência %</th>
                <th class="text-end">Ações</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.Modelo</td>
                    <td>@p.Fabricante</td>
                    <td>@p.Sistema.NomeInstalacao</td>
                    <td>@p.PotenciaMaxima</td>
                    <td>@p.Eficiencia</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@p.Id">Ver</a>
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@p.Id">Editar</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@p.Id">Excluir</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    @if (!Model.Any())
    {
        <div class="p-4 text-center text-muted">Nenhum painel cadastrado.</div>
    }
</div>
