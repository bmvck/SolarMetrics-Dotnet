@model SolarMetrics.Web.Models.ChatbotHistoryViewModel
@{
    ViewData["Title"] = "Histórico do assistente IA";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <p class="text-muted mb-0">Interações registradas no MongoDB (somente leitura)</p>
    <a asp-action="Index" class="btn btn-primary btn-sm">
        <i class="fas fa-robot me-1"></i>Abrir assistente
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        @if (!Model.Items.Any())
        {
            <div class="text-center py-5 text-muted">
                Nenhuma interação registrada ainda. Use o assistente IA para gerar o primeiro registro.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                    <tr>
                        <th>Data (UTC)</th>
                        <th>Usuário</th>
                        <th>Pergunta</th>
                        <th>Status</th>
                        <th>Duração</th>
                        <th>Fonte</th>
                        <th></th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model.Items)
                    {
                        var collapseId = $"answer-{item.Id}";
                        <tr>
                            <td class="small text-nowrap">@item.CreatedAtUtc.ToString("dd/MM/yyyy HH:mm:ss")</td>
                            <td class="small">@(item.UserName ?? "—")</td>
                            <td class="small" style="max-width: 280px;">
                                @(item.Question.Length > 120 ? item.Question[..120] + "…" : item.Question)
                            </td>
                            <td>
                                @if (item.Success)
                                {
                                    <span class="badge bg-success">OK</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger" title="@item.ErrorMessage">Erro</span>
                                }
                            </td>
                            <td class="small text-nowrap">@item.DurationMs ms</td>
                            <td class="small text-muted">@(item.Source ?? "—")</td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-secondary"
                                        type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#@collapseId"
                                        aria-expanded="false"
                                        aria-controls="@collapseId">
                                    Detalhes
                                </button>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="7" class="p-0 border-0">
                                <div class="collapse bg-light small p-3" id="@collapseId">
                                    @if (!item.Success && !string.IsNullOrWhiteSpace(item.ErrorMessage))
                                    {
                                        <p class="mb-2 text-danger"><strong>Erro:</strong> @item.ErrorMessage</p>
                                    }
                                    <p class="mb-1"><strong>Pergunta completa:</strong> @item.Question</p>
                                    @if (!string.IsNullOrWhiteSpace(item.Answer))
                                    {
                                        <p class="mb-0"><strong>Resposta:</strong> @item.Answer</p>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3" aria-label="Paginação do histórico">
        <ul class="pagination pagination-sm mb-0">
            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                <a class="page-link" asp-action="History" asp-route-page="@(Model.Page - 1)">Anterior</a>
            </li>
            <li class="page-item disabled">
                <span class="page-link">Página @Model.Page de @Model.TotalPages (@Model.TotalCount registros)</span>
            </li>
            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                <a class="page-link" asp-action="History" asp-route-page="@(Model.Page + 1)">Próxima</a>
            </li>
        </ul>
    </nav>
}
