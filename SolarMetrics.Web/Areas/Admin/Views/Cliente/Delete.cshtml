@model SolarMetrics.Web.Models.Cliente

@{
    ViewData["Title"] = "Excluir cliente";
}

<p class="text-muted">Tem certeza que deseja excluir <strong>@Model.Nome</strong>? Sistemas vinculados serão removidos em cascata.</p>

<form asp-action="Delete" method="post" onsubmit="return confirm('Confirmar exclusão?');">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" value="@Model.Id"/>

    <button type="submit" class="btn btn-danger">Excluir</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
</form>
