@model MonitoramentoFormViewModel
@{
    ViewData["Title"] = "Editar monitoramento";
}

<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
    <input type="hidden" asp-for="Id"/>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="SensorId" class="form-label">Sensor</label>
            <select asp-for="SensorId" class="form-select" asp-items="ViewBag.SensorId"></select>
            <span asp-validation-for="SensorId" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Periodo" class="form-label"></label>
            <input asp-for="Periodo" class="form-control" type="date"/>
            <span asp-validation-for="Periodo" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="ValorLido" class="form-label"></label>
            <input asp-for="ValorLido" class="form-control" type="number"/>
            <span asp-validation-for="ValorLido" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="MediaLeitura" class="form-label"></label>
            <input asp-for="MediaLeitura" class="form-control" type="number"/>
            <span asp-validation-for="MediaLeitura" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="MaximaLeitura" class="form-label"></label>
            <input asp-for="MaximaLeitura" class="form-control" type="number"/>
            <span asp-validation-for="MaximaLeitura" class="text-danger"></span>
        </div>
    </div>
    <div class="mt-4">
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        <button type="submit" class="btn btn-primary">Salvar</button>
    </div>
</form>

@section Scripts {
    @{ await Html.RenderPartialAsync("~/Views/Shared/_ValidationScriptsPartial.cshtml"); }
}
