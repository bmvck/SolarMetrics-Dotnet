@{
    var area = "Admin";
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] — Admin SolarMetrics</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
</head>
<body class="bg-light">
<div class="d-flex min-vh-100">
    <aside class="border-end bg-white" style="width: 260px; min-width: 260px;">
        <div class="p-3 border-bottom">
            <a asp-area="@area" asp-controller="Dashboard" asp-action="Index" class="text-decoration-none text-dark fw-semibold">
                <i class="fas fa-solar-panel text-primary me-2"></i>SolarMetrics Admin
            </a>
        </div>
        <nav class="nav flex-column p-2 small">
            <a class="nav-link rounded @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active bg-primary-subtle" : "")"
               asp-area="@area" asp-controller="Dashboard" asp-action="Index">
                <i class="fas fa-chart-pie me-2"></i>Dashboard
            </a>
            <a class="nav-link rounded @(ViewContext.RouteData.Values["controller"]?.ToString() == "Cliente" ? "active bg-primary-subtle" : "")"
               asp-area="@area" asp-controller="Cliente" asp-action="Index">
                <i class="fas fa-users me-2"></i>Clientes
            </a>
            <a class="nav-link rounded @(ViewContext.RouteData.Values["controller"]?.ToString() == "Sistema" ? "active bg-primary-subtle" : "")"
               asp-area="@area" asp-controller="Sistema" asp-action="Index">
                <i class="fas fa-building me-2"></i>Sistemas
            </a>
            <a class="nav-link rounded @(ViewContext.RouteData.Values["controller"]?.ToString() == "PainelSolar" ? "active bg-primary-subtle" : "")"
               asp-area="@area" asp-controller="PainelSolar" asp-action="Index">
                <i class="fas fa-th-large me-2"></i>Painéis solares
            </a>
            <a class="nav-link rounded @(ViewContext.RouteData.Values["controller"]?.ToString() == "Sensor" ? "active bg-primary-subtle" : "")"
               asp-area="@area" asp-controller="Sensor" asp-action="Index">
                <i class="fas fa-microchip me-2"></i>Sensores
            </a>
            <a class="nav-link rounded @(ViewContext.RouteData.Values["controller"]?.ToString() == "Monitoramento" ? "active bg-primary-subtle" : "")"
               asp-area="@area" asp-controller="Monitoramento" asp-action="Index">
                <i class="fas fa-wave-square me-2"></i>Monitoramentos
            </a>
        </nav>
        <div class="p-3 mt-auto border-top small">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm w-100 mb-2">Site público</a>
            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger btn-sm w-100">Sair</button>
            </form>
        </div>
    </aside>
    <div class="flex-grow-1 d-flex flex-column">
        <header class="bg-white border-bottom py-3 px-4">
            <h1 class="h4 mb-0">@ViewData["Title"]</h1>
        </header>
        <main class="flex-grow-1 p-4">
            @RenderBody()
        </main>
    </div>
</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
