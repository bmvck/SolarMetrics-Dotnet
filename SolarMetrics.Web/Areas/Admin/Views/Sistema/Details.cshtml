@model SolarMetrics.Web.Models.Sistema
@{
    ViewData["Title"] = "Detalhes do sistema";
}

<dl class="row">
    <dt class="col-sm-3">Instalação</dt>
    <dd class="col-sm-9">@Model.NomeInstalacao</dd>
    <dt class="col-sm-3">Cliente</dt>
    <dd class="col-sm-9">@Model.Cliente.Nome</dd>
    <dt class="col-sm-3">Data instalação</dt>
    <dd class="col-sm-9">@Model.DataInstalacao.ToString("dd/MM/yyyy")</dd>
    <dt class="col-sm-3">Potência total</dt>
    <dd class="col-sm-9">@Model.PotenciaTotal W</dd>
    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Status</dd>
</dl>

<a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
