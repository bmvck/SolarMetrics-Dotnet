@{
    ViewData["Title"] = "Entrar — Admin";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var returnUrl = ViewData["ReturnUrl"] as string ?? Url.Action("Index", "Dashboard", new { area = "Admin" });
}

<div class="container py-5" style="max-width: 480px;">
    <h1 class="h3 mb-3">Painel administrativo</h1>
    <p class="text-muted small">O acesso usa o mesmo JWT da API. Em desenvolvimento, se a API não responder, um token local é emitido.</p>

    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <form asp-action="Login" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="returnUrl" value="@returnUrl" />
        <button type="submit" class="btn btn-primary w-100">Obter sessão e entrar</button>
    </form>

    <p class="mt-4 small text-muted mb-0">
        <a asp-area="" asp-controller="Home" asp-action="Index">Voltar ao site</a>
    </p>
</div>
